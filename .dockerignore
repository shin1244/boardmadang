# 이미지에 넣지 않을 것. Dockerfile은 필요한 폴더만 복사하지만, 비밀값과 비공개 게임은 여기서 한 번 더 막습니다.

# 비밀값
.env
.env.*

# 공개하지 않는 게임. 이미지에 넣으면 사이트에서 누구나 코드를 받아 갈 수 있습니다.
games/private/

# 개발 중에 쌓인 데이터와 빌드 결과물, 학습 결과물
server/data/
server/bin/
trainer/

# 운영에 필요 없는 것
.git/
.github/
docs/
**/node_modules/
**/*.test.js
**/*.test.mjs
**/*_test.go
