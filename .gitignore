# 비밀값 — 절대 커밋하지 않습니다. 예시는 .env.example에 둡니다.
.env
.env.*
!.env.example

# 공개하지 않는 게임 — 이 폴더는 깃허브에 올라가지 않습니다.
/games/private/

# Go
/server/bin/
# 개발 서버가 저장한 기보 (DATA_DIR 기본값)
/server/data/
*.exe
*.test
*.out

# trainer (Python, 학습 결과물)
__pycache__/
.venv/
*.pt
*.onnx
/trainer/runs/
/trainer/checkpoints/

# web (나중에)
node_modules/
dist/

# 편집기, OS
.idea/
.vscode/
.DS_Store
Thumbs.db
