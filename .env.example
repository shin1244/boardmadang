# 서버가 들을 포트. GCP(Cloud Run 등)는 PORT 환경변수로 넘겨줍니다.
PORT=8080

# 웹소켓 접속을 허용할 출처(Origin). 쉼표로 구분합니다.
# 비워두면 서버와 같은 출처만 허용합니다.
ALLOWED_ORIGINS=http://localhost:5173

# 세션 쿠키 서명 비밀값 (docs/identity.md). 32자 이상의 무작위 문자열.
# 비워두면 서버가 켤 때마다 임시 값을 만들어서, 다시 켜면 모든 게스트가 새 게스트가 됩니다.
# 운영에서는 Secret Manager에 넣고 환경변수로 넘깁니다. 만들기: openssl rand -base64 48
SESSION_SECRET=

# 끝난 대국의 기보를 저장할 폴더. 비워두면 server/data (서버를 켠 폴더 기준 data).
# 운영(VM)에서는 영구 디스크의 폴더를 넣습니다. 도커면 볼륨을 붙입니다: -v boardmadang-data:/data
DATA_DIR=
